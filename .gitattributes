# Normalise text to LF in the repository; check out with the platform's endings.
* text=auto

# Keep shell scripts and Gradle wrappers LF even on Windows checkouts.
*.sh        text eol=lf
gradlew     text eol=lf
*.gradle    text eol=lf
*.kts       text eol=lf

# Windows-only scripts stay CRLF.
*.bat       text eol=crlf
*.cmd       text eol=crlf

# Never touch binaries.
*.ttf       binary
*.otf       binary
*.jar       binary
*.png       binary
*.jpg       binary
*.wav       binary
*.mp3       binary
*.mp4       binary
*.onnx      binary
