# ============================================================
#  AutoTube AI - environment template.  Copy to `.env`.
#  NEVER commit the real .env.  See docs/SECURITY.md
# ============================================================

# ---------- YouTube Data / Analytics API (required) ----------
# Free. Google Cloud project -> enable "YouTube Data API v3".
# API key is used for read-only research (search/videos/channels).
YOUTUBE_API_KEY=

# OAuth client (type: Desktop app) for upload + own-channel analytics.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# ---------- LLM providers (pick at least one; all have free tiers) ----------
# Groq: free tier, no credit card. https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google AI Studio (Gemini): free tier, no credit card.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Ollama: fully local, no key, no cost. Install from ollama.com
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# ---------- Stock imagery (optional, free keys, no credit card) ----------
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ---------- Backend API auth (protects your own endpoints) ----------
# Long random string. The Android app sends this as `X-API-Key`.
AUTOTUBE_API_TOKEN=

# ---------- Behaviour ----------
DRY_RUN=true
# Set both of these to actually upload. FORCE_PRIVATE=true is what makes that
# safe to try: every video is inserted as private with no publishAt, so you can
# confirm uploading works without a subscriber seeing anything. Turn
# FORCE_PRIVATE off only when you intend to publish for real.
UPLOAD_ENABLED=false
# Optional: a better image generator.
#
# The keyless default (Pollinations/sana) has a painterly house style and will
# not draw flat-colour anime line art whatever the prompt says - measured
# across three prompt shapes on a fixed seed. A free Hugging Face account and
# token lets visuals.ai_image_backend=huggingface run any text-to-image model,
# including anime-tuned ones, which is what a Ghibli-style channel needs.
HF_API_TOKEN=
FORCE_PRIVATE=true
AUTOTUBE_CONFIG=./config.yaml
