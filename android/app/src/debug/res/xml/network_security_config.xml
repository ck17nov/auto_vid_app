<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG BUILDS ONLY. This file overrides the one in src/main.

  Why it exists: during setup the phone talks to a backend running on your own
  PC over plain HTTP on the LAN, e.g. http://192.168.1.37:8099. The strict
  config in src/main tried to allow that by listing "192.168.1.0" as a domain
  with includeSubdomains, which does not work - Android matches <domain>
  entries as HOSTNAMES and includeSubdomains does DNS-suffix matching, not
  CIDR. "192.168.1.0" therefore matches nothing you would ever connect to, and
  the app failed with a cleartext-not-permitted error.

  Rather than guess at your LAN address at compile time, debug builds permit
  cleartext generally. The RELEASE build keeps HTTPS-only (see src/main), so
  this can never ship to a store.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <!-- Debug builds also trust user-installed CAs, so you can put the
                 backend behind mitmproxy or a self-signed cert if you want to
                 test the HTTPS path locally. -->
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
