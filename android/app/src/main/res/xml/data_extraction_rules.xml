<?xml version="1.0" encoding="utf-8"?>
<!-- Never back up or transfer credentials or the local database. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="autotube_secure_prefs.xml" />
        <exclude domain="database" path="autotube.db" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="autotube_secure_prefs.xml" />
        <exclude domain="database" path="autotube.db" />
    </device-transfer>
</data-extraction-rules>
