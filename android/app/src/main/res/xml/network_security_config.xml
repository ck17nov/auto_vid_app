<?xml version="1.0" encoding="utf-8"?>
<!--
  RELEASE policy: HTTPS everywhere, system trust anchors only (spec section 31).

  There is a deliberate NO exception for LAN addresses here. An earlier version
  tried to allow them with <domain includeSubdomains="true">192.168.1.0</domain>,
  which does not do what it looks like: Android matches <domain> entries as
  hostnames and includeSubdomains is DNS-suffix matching, not CIDR. That entry
  matched nothing reachable, so plain-HTTP LAN setup failed anyway.

  Listing every possible private address is not practical, and loosening this
  for release builds would mean shipping an app that will talk to any plaintext
  server. Local HTTP is a development concern, so it lives in the debug source
  set instead: src/debug/res/xml/network_security_config.xml.

  If you want the release build to reach a self-hosted backend, give it a real
  hostname and a certificate (a free Let's Encrypt cert, or Tailscale/Cloudflare
  Tunnel, both of which terminate TLS for you).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
